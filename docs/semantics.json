{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Arlo V1 semantic design tokens. UI roles reference foundational values defined in primitives.json.",

  "color": {
    "background": {
      "default": {
        "$type": "color",
        "$description": "Primary Arlo V1 application canvas.",
        "$value": "{color.neutral.100}"
      },
      "subtle": {
        "$type": "color",
        "$description": "Subtle background used to separate supporting content.",
        "$value": "{color.neutral.200}"
      },
      "muted": {
        "$type": "color",
        "$description": "Muted background for disabled or low-emphasis areas.",
        "$value": "{color.neutral.300}"
      },
      "accent": {
        "$type": "color",
        "$description": "Very subtle primary brand background.",
        "$value": "{color.primary.50}"
      }
    },

    "surface": {
      "default": {
        "$type": "color",
        "$description": "Default contained surface.",
        "$value": "{color.neutral.50}"
      },
      "subtle": {
        "$type": "color",
        "$description": "Low-contrast supporting surface.",
        "$value": "{color.neutral.100}"
      },
      "raised": {
        "$type": "color",
        "$description": "Raised surface used where additional hierarchy is required.",
        "$value": "{color.neutral.50}"
      },
      "accent": {
        "$type": "color",
        "$description": "Subtle primary-tinted surface.",
        "$value": "{color.primary.50}"
      },
      "secondary": {
        "$type": "color",
        "$description": "Subtle warm-taupe surface.",
        "$value": "{color.secondary.50}"
      }
    },

    "text": {
      "default": {
        "$type": "color",
        "$description": "Primary application text.",
        "$value": "{color.neutral.950}"
      },
      "subtle": {
        "$type": "color",
        "$description": "Supporting text.",
        "$value": "{color.neutral.700}"
      },
      "muted": {
        "$type": "color",
        "$description": "Low-emphasis text and metadata.",
        "$value": "{color.neutral.500}"
      },
      "disabled": {
        "$type": "color",
        "$description": "Disabled or unavailable text.",
        "$value": "{color.neutral.400}"
      },
      "inverse": {
        "$type": "color",
        "$description": "Text displayed on dark or strong coloured surfaces.",
        "$value": "{color.neutral.50}"
      },
      "brand": {
        "$type": "color",
        "$description": "Primary Arlo brand text.",
        "$value": "{color.primary.700}"
      },
      "secondary": {
        "$type": "color",
        "$description": "Secondary warm-taupe text.",
        "$value": "{color.secondary.700}"
      }
    },

    "border": {
      "default": {
        "$type": "color",
        "$description": "Standard component boundary.",
        "$value": "{color.neutral.300}"
      },
      "subtle": {
        "$type": "color",
        "$description": "Low-contrast divider or boundary.",
        "$value": "{color.neutral.200}"
      },
      "strong": {
        "$type": "color",
        "$description": "Emphasised boundary.",
        "$value": "{color.neutral.500}"
      },
      "brand": {
        "$type": "color",
        "$description": "Primary brand boundary for focused or selected states.",
        "$value": "{color.primary.300}"
      },
      "secondary": {
        "$type": "color",
        "$description": "Secondary warm-taupe boundary.",
        "$value": "{color.secondary.300}"
      }
    },

    "action": {
      "primary": {
        "default": {
          "$type": "color",
          "$description": "Primary interactive action background.",
          "$value": "{color.primary.600}"
        },
        "pressed": {
          "$type": "color",
          "$description": "Primary action pressed state.",
          "$value": "{color.primary.700}"
        },
        "disabled": {
          "$type": "color",
          "$description": "Disabled primary action background.",
          "$value": "{color.neutral.300}"
        },
        "foreground": {
          "$type": "color",
          "$description": "Text or icon displayed on a primary action.",
          "$value": "{color.neutral.50}"
        }
      },

      "secondary": {
        "default": {
          "$type": "color",
          "$description": "Secondary interactive action background.",
          "$value": "{color.neutral.200}"
        },
        "pressed": {
          "$type": "color",
          "$description": "Secondary action pressed state.",
          "$value": "{color.neutral.300}"
        },
        "disabled": {
          "$type": "color",
          "$description": "Disabled secondary action background.",
          "$value": "{color.neutral.200}"
        },
        "foreground": {
          "$type": "color",
          "$description": "Text or icon displayed on a secondary action.",
          "$value": "{color.neutral.900}"
        }
      },

      "ghost": {
        "default": {
          "$type": "color",
          "$description": "Low-emphasis action foreground.",
          "$value": "{color.primary.700}"
        },
        "pressed": {
          "$type": "color",
          "$description": "Ghost action pressed treatment.",
          "$value": "{color.primary.100}"
        },
        "disabled": {
          "$type": "color",
          "$description": "Disabled ghost action foreground.",
          "$value": "{color.neutral.400}"
        },
        "foreground": {
          "$type": "color",
          "$description": "Ghost action text or icon.",
          "$value": "{color.primary.700}"
        }
      }
    },

    "brand": {
      "primary": {
        "$type": "color",
        "$description": "Primary Arlo brand colour.",
        "$value": "{color.primary.500}"
      },
      "secondary": {
        "$type": "color",
        "$description": "Secondary Arlo warm taupe brand colour.",
        "$value": "{color.secondary.500}"
      },
      "accent": {
        "$type": "color",
        "$description": "Arlo accent role using the primary brand family.",
        "$value": "{color.primary.500}"
      }
    },

    "icon": {
      "default": {
        "$type": "color",
        "$description": "Default icon colour.",
        "$value": "{color.neutral.700}"
      },
      "subtle": {
        "$type": "color",
        "$description": "Low-emphasis icon colour.",
        "$value": "{color.neutral.500}"
      },
      "muted": {
        "$type": "color",
        "$description": "Muted or disabled icon colour.",
        "$value": "{color.neutral.400}"
      },
      "brand": {
        "$type": "color",
        "$description": "Primary brand icon colour.",
        "$value": "{color.primary.600}"
      },
      "secondary": {
        "$type": "color",
        "$description": "Secondary warm-taupe icon colour.",
        "$value": "{color.secondary.600}"
      },
      "inverse": {
        "$type": "color",
        "$description": "Icon colour used on dark or strong surfaces.",
        "$value": "{color.neutral.50}"
      }
    },

    "focus": {
      "default": {
        "$type": "color",
        "$description": "Primary focus indicator.",
        "$value": "{color.primary.500}"
      },
      "subtle": {
        "$type": "color",
        "$description": "Subtle focus surface treatment.",
        "$value": "{color.primary.50}"
      }
    },

    "feedback": {
      "success": {
        "background": {
          "$type": "color",
          "$value": "{color.success.100}"
        },
        "default": {
          "$type": "color",
          "$value": "{color.success.500}"
        },
        "strong": {
          "$type": "color",
          "$value": "{color.success.700}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.950}"
        }
      },
      "warning": {
        "background": {
          "$type": "color",
          "$value": "{color.warning.100}"
        },
        "default": {
          "$type": "color",
          "$value": "{color.warning.500}"
        },
        "strong": {
          "$type": "color",
          "$value": "{color.warning.700}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.950}"
        }
      },
      "error": {
        "background": {
          "$type": "color",
          "$value": "{color.error.100}"
        },
        "default": {
          "$type": "color",
          "$value": "{color.error.500}"
        },
        "strong": {
          "$type": "color",
          "$value": "{color.error.700}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.950}"
        }
      },
      "info": {
        "background": {
          "$type": "color",
          "$value": "{color.info.100}"
        },
        "default": {
          "$type": "color",
          "$value": "{color.info.500}"
        },
        "strong": {
          "$type": "color",
          "$value": "{color.info.700}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.950}"
        }
      }
    }
  },

  "spacing": {
    "layout": {
      "page": {
        "$type": "dimension",
        "$value": "{spacing.4}"
      },
      "section": {
        "$type": "dimension",
        "$value": "{spacing.8}"
      },
      "content": {
        "$type": "dimension",
        "$value": "{spacing.6}"
      }
    },

    "component": {
      "padding-sm": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      },
      "padding-md": {
        "$type": "dimension",
        "$value": "{spacing.4}"
      },
      "padding-lg": {
        "$type": "dimension",
        "$value": "{spacing.6}"
      },
      "gap-sm": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      },
      "gap-md": {
        "$type": "dimension",
        "$value": "{spacing.4}"
      },
      "gap-lg": {
        "$type": "dimension",
        "$value": "{spacing.6}"
      }
    }
  },

  "radius": {
    "input": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "card": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "button": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "pill": {
      "$type": "dimension",
      "$value": "{radius.full}"
    }
  },

  "border": {
    "subtle": {
      "$type": "dimension",
      "$value": "{borderWidth.subtle}"
    },
    "default": {
      "$type": "dimension",
      "$value": "{borderWidth.default}"
    },
    "strong": {
      "$type": "dimension",
      "$value": "{borderWidth.strong}"
    }
  },

  "typography": {
    "task": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.fontFamily.primary}",
        "fontSize": "{typography.fontSize.md}",
        "fontWeight": "{typography.fontWeight.regular}",
        "lineHeight": "{typography.lineHeight.normal}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      }
    },

    "metadata": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.fontFamily.primary}",
        "fontSize": "{typography.fontSize.sm}",
        "fontWeight": "{typography.fontWeight.regular}",
        "lineHeight": "{typography.lineHeight.normal}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      }
    },

    "section": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.fontFamily.primary}",
        "fontSize": "{typography.fontSize.sm}",
        "fontWeight": "{typography.fontWeight.medium}",
        "lineHeight": "{typography.lineHeight.normal}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      }
    },

    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.fontFamily.primary}",
        "fontSize": "{typography.fontSize.xs}",
        "fontWeight": "{typography.fontWeight.medium}",
        "lineHeight": "{typography.lineHeight.normal}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      }
    }
  },

  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "{shadow.none}"
    },
    "subtle": {
      "$type": "shadow",
      "$value": "{shadow.sm}"
    },
    "default": {
      "$type": "shadow",
      "$value": "{shadow.md}"
    }
  },

  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "{motion.duration.instant}"
      },
      "fast": {
        "$type": "duration",
        "$value": "{motion.duration.fast}"
      },
      "normal": {
        "$type": "duration",
        "$value": "{motion.duration.normal}"
      },
      "deliberate": {
        "$type": "duration",
        "$value": "{motion.duration.deliberate}"
      }
    },

    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.standard}"
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.enter}"
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.exit}"
      }
    }
  }
}